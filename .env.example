# Base de datos PostgreSQL (Neon). Usa la URL "pooled" en DATABASE_URL y la directa en DIRECT_URL.
DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=require"
DIRECT_URL="postgresql://usuario:clave@host/db?sslmode=require"

# Contraseña para entrar a /admin (usa una larga).
ADMIN_PASSWORD="cambia-esto"
# Secreto para firmar la sesión. Genera uno con: openssl rand -base64 32
AUTH_SECRET="genera-un-secreto-largo"

# Vercel Blob (lo crea Vercel al conectar un Blob store). Sin esta variable, en local
# las imágenes se guardan en public/uploads.
BLOB_READ_WRITE_TOKEN=""
